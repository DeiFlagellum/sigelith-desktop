#: beatstamp/api.py:191
msgid "The API request limit was exceeded (20 stamps per minute per IP address). "
msgstr "Przekroczono limit zapytań do API (20 stempli na minutę na adres IP). "

#: beatstamp/api.py:201
msgid "The BeatTime server returned error %(code)s. Try again in a moment."
msgstr "Serwer BeatTime zwrócił błąd %(code)s. Spróbuj ponownie za chwilę."

#: beatstamp/bundle.py:208
#: beatstamp/proof.py:536
msgid "The Ed25519 signature of the week root is invalid."
msgstr "Podpis Ed25519 korzenia tygodnia jest nieprawidłowy."

#: beatstamp/ui/main_window.py:513
msgid ""
"The OpenTimestamps proof of the week — to be checked with an\n"
"OpenTimestamps client, entirely outside BeatTime and outside this application."
msgstr ""
"Dowód OpenTimestamps tygodnia — do sprawdzenia klientem\n"
"OpenTimestamps, całkowicie poza BeatTime i poza tą aplikacją."

#: beatstamp/__main__.py:115
msgid ""
"The application will try to carry on. The details were written to the event log:\n"
"%(path)s"
msgstr ""
"Aplikacja próbuje działać dalej. Szczegóły zapisano w dzienniku zdarzeń:\n"
"%(path)s"

#: beatstamp/ui/main_window.py:1219
msgid "The certificate could not be saved:<br>%(reason)s"
msgstr "Nie udało się zapisać certyfikatu:<br>%(reason)s"

#: beatstamp/ui/dialogs.py:588
msgid ""
"The certificate gets the name \"document_beattime.pdf\" instead of\n"
"asking for it every time."
msgstr ""
"Certyfikat dostanie nazwę \"dokument_beattime.pdf\" zamiast\n"
"pytać o nią za każdym razem."

#: beatstamp/ui/dialogs.py:255
msgid "The choice could not be written down, so the next start will go back to the previous folder."
msgstr "Nie udało się zapisać tego wyboru, więc przy następnym uruchomieniu obowiązywać będzie poprzedni folder."

#: beatstamp/ui/main_window.py:1671
msgid "The clock was not synchronised: %(reason)s"
msgstr "Nie zsynchronizowano zegara: %(reason)s"

#: beatstamp/ui/main_window.py:602
msgid "The complete entry data (JSON)"
msgstr "Pełne dane wpisu (JSON)"

#: beatstamp/ui/main_window.py:518
msgid "The complete proof data (JSON)"
msgstr "Pełne dane dowodu (JSON)"

#: beatstamp/ui/dialogs.py:1160
msgid "The complete proof data in JSON. The <b>.beatproof</b> export writes the same values — you can check them with your own tool."
msgstr "Komplet danych dowodu w formacie JSON. Te same wartości zapisuje eksport <b>.beatproof</b> — możesz je sprawdzić własnym narzędziem."

#: beatstamp/ui/main_window.py:403
msgid "The complete technical proof data in JSON"
msgstr "Pełne dane techniczne dowodu w formacie JSON"

#: beatstamp/ui/dialogs.py:641
msgid "The current data folder. Changing it copies the files to the new place and checks straight away that writing works there — the old folder is left untouched."
msgstr "Obecny katalog danych. Zmiana kopiuje pliki w nowe miejsce i od razu sprawdza, czy zapis tam działa — stary folder zostaje nietknięty."

#: beatstamp/ui/dialogs.py:310
msgid "The data are copied to the new folder; nothing is deleted from the old one."
msgstr "Dane zostaną skopiowane do nowego folderu; ze starego nic nie znika."

#: beatstamp/config.py:507
msgid ""
"The data folder does not accept writes:\n"
"%(path)s\n"
"\n"
"What the system reports: %(reason)s\n"
"\n"
"Pick another folder for the data — nothing is deleted, whatever is already in the old folder stays there."
msgstr ""
"Katalog danych nie przyjmuje zapisu:\n"
"%(path)s\n"
"\n"
"Co zgłasza system: %(reason)s\n"
"\n"
"Wskaż inny folder na dane — nic nie zostanie skasowane, wszystko, co jest w starym folderze, tam zostaje."

#: beatstamp/ui/dialogs.py:246
msgid "The data folder is now:"
msgstr "Katalog danych to teraz:"

#: beatstamp/certificate.py:483
msgid "The digest in this entry has an invalid format — the QR code was skipped"
msgstr "Skrót w tym wpisie ma nieprawidłowy format — kod QR pominięty"

#: beatstamp/proof.py:114
msgid "The digest is in the public, append-only register. The current week is still running, so the Merkle root has not been frozen yet — the signature and the anchor arrive once it closes (Monday 00:00 UTC)."
msgstr "Skrót jest w publicznym, dopisywalnym-tylko rejestrze. Bieżący tydzień jeszcze trwa, więc korzeń Merkle nie został zamrożony — podpis i kotwica dojdą po jego zamknięciu (poniedziałek 00:00 UTC)."

#: beatstamp/bundle.py:179
msgid "The digest of the selected file does NOT match the digest in the proof. The file was changed, or the proof is about a different document."
msgstr "Skrót wskazanego pliku NIE zgadza się ze skrótem w dowodzie. Plik został zmieniony albo dowód dotyczy innego dokumentu."

#: beatstamp/hashing.py:161
msgid "The file \"%(name)s\" could not be read."
msgstr "Nie udało się odczytać pliku \"%(name)s\"."

#: beatstamp/hashing.py:149
msgid "The file \"%(name)s\" does not exist or has been moved."
msgstr "Plik \"%(name)s\" nie istnieje lub został przeniesiony."

#: beatstamp/hashing.py:153
msgid "The file \"%(name)s\" is in use by another program."
msgstr "Plik \"%(name)s\" jest używany przez inny program."

#: beatstamp/hashing.py:158
msgid "The file \"%(name)s\" is open in another program and locked for reading. Close it and try again."
msgstr "Plik \"%(name)s\" jest otwarty w innym programie i zablokowany do odczytu. Zamknij go i spróbuj ponownie."

#: beatstamp/ui/main_window.py:1195
msgid "The file <b>%(name)s</b> already exists in this folder.<br><br>Overwrite it?"
msgstr "Plik <b>%(name)s</b> już istnieje w tym katalogu.<br><br>Nadpisać go?"

#: beatstamp/ui/main_window.py:1194
msgid "The file already exists"
msgstr "Plik już istnieje"

#: beatstamp/bundle.py:145
msgid "The file does not contain a valid JSON object."
msgstr "Plik nie zawiera poprawnego obiektu JSON."

#: beatstamp/bundle.py:249
msgid "The file is not a valid JSON document."
msgstr "Plik nie jest poprawnym dokumentem JSON."

#: beatstamp/ui/main_window.py:1040
msgid "The file was never stamped, or it was changed after stamping — even a single changed byte gives a completely different digest."
msgstr "Plik nie był stemplowany albo został zmieniony po ostemplowaniu — nawet jeden zmieniony bajt daje zupełnie inny skrót."

#: beatstamp/ui/dialogs.py:248
msgid "The files were copied. The previous folder was left untouched: %(path)s"
msgstr "Pliki zostały skopiowane. Poprzedni folder został nietknięty: %(path)s"

#: beatstamp/ui/dialogs.py:669
msgid "The folder is set for this run by the %(name)s environment variable, so it cannot be changed here."
msgstr "Katalog narzuca na to uruchomienie zmienna środowiskowa %(name)s, więc nie da się go tutaj zmienić."

#: beatstamp/history.py:232
msgid "The history file could not be opened: %(reason)s."
msgstr "Nie udało się otworzyć pliku historii: %(reason)s."

#: beatstamp/history.py:252
msgid "The history file had an unexpected structure and has been set aside as \"%(name)s\"."
msgstr "Plik historii miał nieoczekiwaną strukturę i został odłożony na bok jako \"%(name)s\"."

#: beatstamp/history.py:241
msgid "The history file was damaged and has been set aside as \"%(name)s\". The history starts over — the previous entries are in that file."
msgstr "Plik historii był uszkodzony i został odłożony na bok jako \"%(name)s\". Historia zaczyna się od nowa — poprzednie wpisy są w tamtym pliku."

#: beatstamp/ui/main_window.py:1634
msgid "The history is empty"
msgstr "Historia pusta"

#: beatstamp/ui/main_window.py:1608
msgid "The history is empty — there is nothing to refresh."
msgstr "Historia jest pusta — nie ma czego odświeżać."

#: beatstamp/proof.py:520
msgid "The inclusion path does NOT lead to the given week root — the proof data is inconsistent."
msgstr "Ścieżka inkluzji NIE prowadzi do podanego korzenia tygodnia — dane dowodu są niespójne."

#: beatstamp/bundle.py:196
msgid "The inclusion path does not lead to the week root."
msgstr "Ścieżka inkluzji nie prowadzi do korzenia tygodnia."

#: beatstamp/certificate.py:458
msgid "The inclusion path, the root signature or the stamp time do not agree with the proof data. "
msgstr "Ścieżka inkluzji, podpis korzenia albo czas stempla nie zgadzają się z danymi dowodu. "

#: beatstamp/ui/dialogs.py:509
msgid ""
"The key history shipped with this version of the program.\n"
"Public list: beattime.live/spec/#keys"
msgstr ""
"Historia kluczy dostarczona z tą wersją programu.\n"
"Publiczna lista: beattime.live/spec/#keys"

#: beatstamp/ui/dialogs.py:1226
msgid "The licence texts are missing from this installation: %(path)s"
msgstr "W tej instalacji brakuje tekstów licencji: %(path)s"

#: beatstamp/ui/dialogs.py:1092
msgid "The list could not be loaded. %(reason)s"
msgstr "Nie udało się wczytać listy. %(reason)s"

#: beatstamp/ui/dialogs.py:1090
msgid "The list could not be refreshed. %(reason)s"
msgstr "Nie udało się odświeżyć listy. %(reason)s"

#: beatstamp/ui/dialogs.py:1099
msgid "The list did not arrive in time. Please try again in a moment."
msgstr "Lista nie dotarła na czas. Spróbuj ponownie za chwilę."

#: beatstamp/ui/dialogs.py:1004
msgid "The list is downloaded from beattime.live — it is not part of the installed program."
msgstr "Lista jest pobierana z beattime.live — nie jest częścią zainstalowanego programu."

#: beatstamp/supporters.py:155
#: beatstamp/supporters.py:198
#: beatstamp/supporters.py:202
msgid "The list of supporters came back in an unexpected format."
msgstr "Lista wspierających wróciła w nieoczekiwanej postaci."

#: beatstamp/ui/dialogs.py:1273
msgid "The log is still empty."
msgstr "Dziennik jest jeszcze pusty."

#: beatstamp/ui/dialogs.py:992
msgid "The names come from a public list on beattime.live. Everyone on it asked to be named and can withdraw at any time, so BeatStamp reloads the list at least once a day and keeps no copy older than that."
msgstr "Nazwy pochodzą z publicznej listy na beattime.live. Każda z tych osób sama poprosiła o wymienienie i może wycofać zgodę w dowolnej chwili, dlatego BeatStamp pobiera listę co najmniej raz na dobę i nie trzyma starszej kopii."

#: beatstamp/ui/main_window.py:1833
msgid "The new language applies to texts drawn from now on. The whole window switches after BeatStamp is restarted."
msgstr "Nowy język obowiązuje dla napisów rysowanych od tej chwili. Całe okno przełącza się po ponownym uruchomieniu BeatStamp."

#: beatstamp/ui/main_window.py:330
msgid ""
"The note stays ONLY on this computer, in the local history.\n"
"It is not sent to the register and does not reach the server certificate.\n"
"It is saved together with the stamp and on every change of the text."
msgstr ""
"Notatka zostaje wyłącznie na tym komputerze, w historii lokalnej.\n"
"Nie jest wysyłana do rejestru i nie trafia do certyfikatu serwerowego.\n"
"Zapisuje się razem ze stemplem oraz przy każdej zmianie tekstu."

#: beatstamp/ui/main_window.py:369
msgid "The only information that reaches the BeatTime register"
msgstr "Jedyna informacja, która trafia do rejestru BeatTime"

#: beatstamp/hashing.py:152
msgid "The path to the file \"%(name)s\" is too long."
msgstr "Ścieżka do pliku \"%(name)s\" jest za długa."

#: beatstamp/ui/dialogs.py:596
msgid ""
"The previous version of the program overwrote certificates silently\n"
"when a file of the same name was already in the folder."
msgstr ""
"Poprzednia wersja programu nadpisywała certyfikaty po cichu,\n"
"gdy w katalogu był już plik o tej samej nazwie."

#: beatstamp/bundle.py:225
msgid "The proof contains no public key for the signature."
msgstr "Dowód nie zawiera klucza publicznego podpisu."

#: beatstamp/bundle.py:228
msgid "The proof contains no root signature. Export it again once the week has closed so that it is complete."
msgstr "Dowód nie zawiera podpisu korzenia. Wyeksportuj go ponownie po zamknięciu tygodnia, żeby był kompletny."

#: beatstamp/bundle.py:199
msgid "The proof contains no week root — the week was still open when it was exported."
msgstr "Dowód nie zawiera korzenia tygodnia — tydzień był jeszcze otwarty w chwili eksportu."

#: beatstamp/ui/main_window.py:1240
msgid "The proof could not be saved:<br>%(reason)s"
msgstr "Nie udało się zapisać dowodu:<br>%(reason)s"

#: beatstamp/ui/main_window.py:1055
msgid "The proof data did not pass the local check:"
msgstr "Dane dowodu nie przeszły kontroli lokalnej:"

#: beatstamp/bundle.py:161
msgid "The proof does not contain a valid SHA-256 digest."
msgstr "Dowód nie zawiera poprawnego skrótu SHA-256."

#: beatstamp/bundle.py:241
msgid "The proof file could not be opened: %(reason)s."
msgstr "Nie udało się otworzyć pliku dowodu: %(reason)s."

#: beatstamp/bundle.py:251
msgid "The proof file has an unexpected structure."
msgstr "Plik dowodu ma nieoczekiwaną strukturę."

#: beatstamp/bundle.py:245
msgid "The proof file is unnaturally large — rejected."
msgstr "Plik dowodu jest nienaturalnie duży — odrzucono."

#: beatstamp/bundle.py:167
msgid "The proof gives the week in an invalid format."
msgstr "Dowód podaje tydzień w nieprawidłowym formacie."

#: beatstamp/bundle.py:170
msgid "The proof gives the week root in an invalid format."
msgstr "Dowód podaje korzeń tygodnia w nieprawidłowym formacie."

#: beatstamp/ui/main_window.py:1174
msgid "The proof is consistent but not closed yet — it was exported before the week ended. Check the digest in the register (the <b>Check digest</b> button) and export the proof again."
msgstr "Dowód jest spójny, ale jeszcze niedomknięty — wyeksportowano go przed zamknięciem tygodnia. Sprawdź skrót w rejestrze (przycisk <b>Sprawdź skrót</b>) i wyeksportuj dowód ponownie."

#: beatstamp/ui/main_window.py:891
#: beatstamp/ui/main_window.py:1058
msgid "The proof needs refreshing"
msgstr "Dowód wymaga odświeżenia"

#: beatstamp/ui/main_window.py:1166
msgid "The proof needs refreshing — %(name)s"
msgstr "Dowód wymaga odświeżenia — %(name)s"

#: beatstamp/ui/main_window.py:1153
msgid "The proof was checked <b>entirely locally</b> — without connecting to beattime.live and without trusting anyone. The inclusion path, the root signature, the identity of the key and the week of the stamp all add up. The signature confirms that the document existed no later than the end of the week; the exact moment is given by the register."
msgstr "Dowód sprawdzony <b>w całości lokalnie</b> — bez łączenia się z beattime.live i bez zaufania do kogokolwiek. Zgadza się ścieżka inkluzji, podpis korzenia, tożsamość klucza i tydzień stempla. Podpis potwierdza istnienie dokumentu najpóźniej z końcem tygodnia; dokładną chwilę podaje rejestr."

#: beatstamp/ui/main_window.py:1799
msgid "The proxy \"%(proxy)s\" is not a local address. Traffic to the .onion service goes over plain HTTP, so it reaches that machine in clear text — this is NOT anonymisation."
msgstr "Proxy „%(proxy)s\" nie jest adresem lokalnym. Ruch do usługi .onion idzie zwykłym HTTP-em, więc trafia jawnym tekstem do tej maszyny — to NIE jest anonimizacja."

#: beatstamp/ui/main_window.py:670
msgid "The public verification page"
msgstr "Publiczna strona weryfikacji"

#: beatstamp/ui/main_window.py:880
msgid "The register did not confirm the write. Try again."
msgstr "Rejestr nie potwierdził zapisu. Spróbuj ponownie."

#: beatstamp/proof.py:430
msgid "The root of week%(week)s was signed with a BeatTime key retired on %(when)s. A signature from a retired key is no longer a proof, so the level stays \"Recorded\" — the external anchor is also waiting for confirmation. %(hint)s"
msgstr "Korzeń tygodnia%(week)s podpisano kluczem BeatTime wycofanym %(when)s. Podpis wycofanym kluczem nie jest już dowodem, więc poziom pozostaje „Zarejestrowany\" — kotwica zewnętrzna też czeka na potwierdzenie. %(hint)s"

#: beatstamp/ui/history_model.py:156
msgid ""
"The root signature was not accepted at the last check:\n"
"a key outside the built-in list, or inconsistent proof data.\n"
"\n"
"Refresh statuses (F5) to check the proof again."
msgstr ""
"Podpis korzenia nie został uznany przy ostatniej kontroli:\n"
"klucz spoza listy wbudowanej albo dane dowodu niespójne.\n"
"\n"
"Odśwież statusy (F5), aby sprawdzić dowód ponownie."

#: beatstamp/bundle.py:221
msgid "The root was signed with a key other than the BeatTime keys built into the application — the signature does not prove its origin."
msgstr "Korzeń podpisano innym kluczem niż klucze BeatTime wbudowane w aplikację — podpis nie dowodzi pochodzenia."

#: beatstamp/ui/history_model.py:42
msgid "The same moment in @beat time — without time zones"
msgstr "Ten sam moment w czasie @beat — bez stref czasowych"

#: beatstamp/api.py:169
msgid "The server accepted the connection but sent no answer in time."
msgstr "Serwer przyjął połączenie, ale nie odesłał odpowiedzi w wyznaczonym czasie."

#: beatstamp/api.py:129
msgid "The server address must start with https:// — an unencrypted connection is allowed only for an .onion address."
msgstr "Adres serwera musi zaczynać się od https:// — połączenie nieszyfrowane jest dozwolone tylko dla adresu .onion."

#: beatstamp/ui/main_window.py:888
msgid "The server answer did not pass the local check."
msgstr "Odpowiedź serwera nie przeszła kontroli lokalnej."

#: beatstamp/api.py:239
msgid "The server answer exceeded the allowed size — the download was aborted."
msgstr "Odpowiedź serwera przekroczyła dopuszczalny rozmiar — przerwano pobieranie."

#: beatstamp/proof.py:452
msgid "The server answer is not a valid JSON object."
msgstr "Odpowiedź serwera nie jest poprawnym obiektem JSON."

#: beatstamp/api.py:232
msgid "The server answer is unnaturally large — aborted."
msgstr "Odpowiedź serwera jest nienaturalnie duża — przerwano."

#: beatstamp/proof.py:461
msgid "The server answered with a proof for a DIFFERENT digest than the one sent — the answer was rejected."
msgstr "Serwer odpowiedział dowodem na INNY skrót niż wysłany — odpowiedź odrzucona."

#: beatstamp/api.py:153
msgid "The server certificate could not be verified. The connection was aborted. Check whether something is intercepting the traffic (corporate firewall, antivirus with HTTPS inspection)."
msgstr "Nie udało się zweryfikować certyfikatu serwera. Połączenie przerwano. Sprawdź, czy sieć nie pośredniczy w ruchu (firewall firmowy, antywirus z inspekcją HTTPS)."

#: beatstamp/proof.py:595
msgid "The server claims the week root is anchored, but it did not supply the complete data (inclusion path + signature), so this could not be confirmed locally. The proof level stays \"Recorded\"."
msgstr "Serwer twierdzi, że korzeń tygodnia jest zakotwiczony, ale nie dostarczył kompletu danych (ścieżka inkluzji + podpis), więc nie dało się tego potwierdzić lokalnie. Poziom dowodu pozostaje „Zarejestrowany\"."

#: beatstamp/api.py:165
msgid "The server did not answer in time (limit %(seconds)s s to connect)."
msgstr "Serwer nie odpowiedział w wyznaczonym czasie (limit %(seconds)s s na połączenie)."

#: beatstamp/proof.py:547
msgid "The server did not give a public key for the signature."
msgstr "Serwer nie podał klucza publicznego do podpisu."

#: beatstamp/api.py:342
msgid "The server did not issue a certificate (HTTP %(code)s)."
msgstr "Serwer nie wydał certyfikatu (HTTP %(code)s)."

#: beatstamp/api.py:312
msgid "The server did not return a synchronisation time."
msgstr "Serwer nie zwrócił czasu synchronizacji."

#: beatstamp/proof.py:609
msgid "The server did not supply an inclusion path — membership in the root could not be confirmed locally."
msgstr "Serwer nie dostarczył ścieżki inkluzji — przynależności do korzenia nie dało się potwierdzić lokalnie."

#: beatstamp/proof.py:584
msgid "The server gave a confirmed bank anchor for a root other than the root of this week — that anchor was not accepted."
msgstr "Serwer podał potwierdzoną kotwicę bankową dla innego korzenia niż korzeń tego tygodnia — ta kotwica nie została uznana."

#: beatstamp/proof.py:499
msgid "The server gave the week root in an invalid format — the answer was rejected."
msgstr "Serwer podał korzeń tygodnia w nieprawidłowym formacie — odpowiedź odrzucona."

#: beatstamp/api.py:215
msgid "The server rejected the request (HTTP %(code)s)."
msgstr "Serwer odrzucił zapytanie (HTTP %(code)s)."

#: beatstamp/proof.py:473
msgid "The server returned a digest in an invalid format."
msgstr "Serwer zwrócił skrót w nieprawidłowym formacie."

#: beatstamp/api.py:316
msgid "The server returned a time in an invalid format."
msgstr "Serwer zwrócił czas w nieprawidłowym formacie."

#: beatstamp/api.py:258
#: beatstamp/api.py:267
#: beatstamp/api.py:295
msgid "The server returned an answer in an unexpected format."
msgstr "Serwer zwrócił odpowiedź w nieoczekiwanym formacie."

#: beatstamp/api.py:208
msgid "The server sent back an answer that cannot be read as JSON."
msgstr "Serwer odesłał odpowiedź, której nie da się odczytać jako JSON."

#: beatstamp/api.py:345
msgid "The server sent back data that is not a PDF file."
msgstr "Serwer odesłał dane, które nie są plikiem PDF."

#: beatstamp/ui/dialogs.py:1127
msgid "The server sent more names than this window shows."
msgstr "Serwer przysłał więcej nazw, niż pokazuje to okno."

#: beatstamp/proof.py:550
msgid "The server signed the root with a key OTHER than the BeatTime keys built into the application. The signature may be technically valid, but it does not prove it comes from BeatTime."
msgstr "Serwer podpisał korzeń INNYM kluczem niż klucze BeatTime wbudowane w aplikację. Podpis może być technicznie poprawny, ale nie dowodzi, że pochodzi od BeatTime."

#: beatstamp/api.py:184
msgid "The server tried to redirect the request — rejected for security reasons."
msgstr "Serwer próbował przekierować zapytanie — odrzucono ze względów bezpieczeństwa."

#: beatstamp/ui/main_window.py:118
msgid "The signature comes from a retired BeatTime key."
msgstr "Podpis pochodzi z wycofanego klucza BeatTime."

#: beatstamp/ui/dialogs.py:234
msgid ""
"The stamp history is a list of your documents: their names and their digests. In this folder OneDrive will copy it to the cloud and to your other computers.\n"
"\n"
"Use this folder anyway?"
msgstr ""
"Historia stempli to lista Twoich dokumentów: ich nazwy i skróty. W tym folderze OneDrive skopiuje ją do chmury i na inne Twoje komputery.\n"
"\n"
"Użyć mimo to tego folderu?"

#: beatstamp/proof.py:414
