#: beatstamp/ui/dialogs.py:560
msgid "Sigelith signs weekly Merkle roots with an Ed25519 key. The application checks that signature <b>locally</b> and compares the key with the <b>built-in list of Sigelith keys</b> — never with whatever the server sends.<br><br>Without that, the signature alone would prove nothing: a fake server would send its own key together with a matching signature and everything would add up. A signature from a <b>retired</b> key is not enough either — such a proof has to be refreshed online so that it gets a signature made with the current key."
msgstr "Sigelith podpisuje tygodniowe korzenie Merkle kluczem Ed25519. Aplikacja sprawdza ten podpis <b>lokalnie</b>, a klucz porównuje z <b>wbudowaną listą kluczy Sigelith</b> — nigdy z tym, co przyśle serwer.<br><br>Bez tego sam podpis nic by nie dowodził: fałszywy serwer przysłałby własny klucz razem z pasującym podpisem i wszystko by się zgadzało. Podpis kluczem <b>wycofanym</b> też nie wystarcza — taki dowód trzeba odświeżyć online, żeby dostał podpis aktualnym kluczem."

#: beatstamp/certificate.py:515
msgid "Sigelith — proof of existence %(digest)s"
msgstr "Sigelith — dowód istnienia %(digest)s"

