msgstr "Ya había un archivo con ese nombre, así que la versión de la ubicación anterior se guardó a su lado como: %(names)s"

#: beatstamp/ui/handover_dialogs.py:294
msgid "A folder I choose — I send the file myself"
msgstr "Una carpeta que elijo yo; envío el archivo por mi cuenta"

#: beatstamp/ui/dialogs.py:743
msgid ""
"A folder you share with the other person (OneDrive, Dropbox, Google Drive,\n"
"Syncthing). Packages and answers in it are encrypted to their recipient and\n"
