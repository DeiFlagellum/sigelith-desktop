msgstr "El archivo «%(name)s» está abierto en otro programa y bloqueado para lectura. Ciérralo e inténtalo de nuevo."

#: beatstamp/ui/main_window.py:1567
msgid "The file <b>%(name)s</b> already exists in this folder.<br><br>Overwrite it?"
msgstr "El archivo <b>%(name)s</b> ya existe en esta carpeta.<br><br>¿Sobrescribirlo?"

#: beatstamp/ui/main_window.py:1566
msgid "The file already exists"
msgstr "El archivo ya existe"

#: beatstamp/ui/handover_report.py:136
msgid "The file checked"
msgstr "Archivo comprobado"

#: beatstamp/handover_tasks.py:133
msgid "The file could not be read or written: %(error)s"
msgstr "No se pudo leer ni escribir el archivo: %(error)s"

#: beatstamp/bundle.py:193
msgid "The file does not contain a valid JSON object."
msgstr "El archivo no contiene un objeto JSON válido."

#: beatstamp/api.py:703
#: beatstamp/api.py:710
