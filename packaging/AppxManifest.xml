<?xml version="1.0" encoding="utf-8"?>

<!--
  Sigelith Desktop — manifest paczki MSIX dla Microsoft Store.

  Wartosci w sekcji <Identity> i <PublisherDisplayName> sa przepisane z
  Partner Center (aplikacja → Product management → Product identity) po
  rezerwacji nazwy „Sigelith Desktop" 2026-09-27 (produkt 9N5XK65GTF33;
  wczesniejsza rezerwacja „BeatStamp" z 2026-09-26 wygasa nieuzywana).
  Musza zgadzac sie CO DO ZNAKU,
  razem z wielkoscia liter: Windows odrzuca paczke, ktorej `Publisher` rozni
  sie od tego w certyfikacie podpisujacym choc jednym znakiem, a Sklep
  odrzuca paczke z cudzym `Name`. Nie zmieniac ich recznie — jedynym zrodlem
  jest Product identity.
  Szczegoly i kolejnosc krokow: ../ROZWOJ.md, rozdzial „Paczka dla Microsoft
  Store (MSIX)".

  `Version` podmienia automatycznie `build_msix.ps1` na podstawie
  `__version__` z `beatstamp/__init__.py` — nie trzeba (i nie warto) pisac go
  tutaj recznie. CZWARTY SEGMENT MUSI BYC ZEREM: Sklep rezerwuje go dla
  siebie i odrzuca paczke z wartoscia inna niz 0.
-->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap uap3 desktop">

  <!--
    Z Partner Center (Product identity):
    Name       — „Package/Identity/Name", nadany przez Microsoft przy
                 rezerwacji nazwy.
    Publisher  — „Package/Identity/Publisher", nazwa wyrozniajaca certyfikatu,
                 ktorym Microsoft podpisuje paczke w Sklepie (GUID, a nie
                 „CN=Adam Koch"). Certyfikat testowy z `build_msix.ps1 -SelfSign`
                 dostaje DOKLADNIE ten sam „Subject".
  -->
  <!--
    Tozsamosc produktu „Sigelith Desktop" (Partner Center, 9N5XK65GTF33,
    2026-09-27). `build_msix.ps1` przez `check_identity.ps1` ODMAWIA
    budowania paczki z tozsamoscia BeatStampa (AdamKoch.BeatStamp).
  -->
  <Identity
    Name="AdamKoch.SigelithDesktop"
    Publisher="CN=322BC472-4859-4579-991B-25EE879D3796"
    Version="3.0.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Sigelith Desktop</DisplayName>
    <!--
      Nazwa wydawcy widoczna dla uzytkownika w karcie Sklepu i w „Aplikacje
      i funkcje". Musi zgadzac sie z „Package/Properties/PublisherDisplayName"
      z Product identity (nazwa wydawcy z konta Partner Center).
    -->
    <PublisherDisplayName>Adam Koch</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!--
      MinVersion 10.0.19045.0 to Windows 10 22H2 — ostatnia i jedyna wciaz
      wspierana wersja Windows 10. Nizej nie schodzimy swiadomie: starsze
      wydania nie dostaja juz poprawek bezpieczenstwa, a program, ktorego
      cala tresc to dowod kryptograficzny, nie ma czego szukac na systemie
      bez lat.
      Windows 11 jest objety tym samym wpisem (kazde jego wydanie ma numer
      kompilacji wyzszy niz 19045), a MaxVersionTested mowi tylko, na czym
      wydanie bylo sprawdzone — nie ogranicza instalacji na nowszych.
    -->
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.19045.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!--
    Jezyki paczki. Interfejs tlumaczy gettext (`beatstamp/i18n.py`), a nie
    system zasobow Windows, wiec ta lista niczego nie wybiera w czasie
    dzialania — deklaruje Sklepowi, w jakich jezykach aplikacja istnieje,
    i decyduje o tym, komu pokaze sie w wynikach wyszukiwania.
    Pierwszy wpis jest jezykiem domyslnym paczki.
  -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="pl-PL" />
    <Resource Language="de-DE" />
    <Resource Language="es-ES" />
    <Resource Language="fr-FR" />
    <Resource Language="ru-RU" />
    <Resource Language="tr-TR" />
    <Resource Language="ja-JP" />
    <Resource Language="ko-KR" />
    <Resource Language="zh-CN" />
    <Resource Language="ar-SA" />
  </Resources>

  <Applications>
    <!--
      `Windows.FullTrustApplication` — zwykly program Win32 w paczce MSIX.
      Sigelith Desktop czyta pliki wskazane przez uzytkownika z dowolnego miejsca na
      dysku i zapisuje historie poza AppData, wiec model piaskownicy UWP nie
      wchodzi w gre.
    -->
    <Application Id="SigelithDesktop"
                 Executable="SigelithDesktop.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Sigelith Desktop"
        Description="Proof that a file existed at a point in time. The file never leaves your computer - only its SHA-256 digest goes to the public Sigelith log."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
      <!--
        Sigelith Handover (3.0): dwuklik na paczce, odpowiedzi albo karcie
        otwiera aplikacje, a `MainWindow.open_paths` kieruje plik do zakladki
        Handover — NIGDY do stemplowania (skrot paczki nie ma czego szukac
        w publicznym dzienniku). Pakiet dowodowy to zwykly .zip, bez
        skojarzenia: sprawdza sie go przyciskiem albo na stronie.
      -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="sigelith-handover">
            <uap:DisplayName>Sigelith Handover</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.sigelith-handover</uap:FileType>
              <uap:FileType>.sigelith-answer</uap:FileType>
              <uap:FileType>.sigelith-card</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!--
          Dowody (3.0.1): dwuklik na .beatproof albo na dowodzie pliku z kopii
          Sigelith Backup (.sigelith-proof) otwiera SPRAWDZANIE — `open_paths`
          nigdy ich nie stempluje.
        -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="sigelith-proof">
            <uap:DisplayName>Sigelith proof</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.beatproof</uap:FileType>
              <uap:FileType>.sigelith-proof</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!--
          Alias (3.0.1): `sigelith-desktop.exe` z parametrem handover i plikiem otwiera okno
          wysylki Sigelith Handover z tym plikiem — tak wola go Sigelith Backup
          („Przekaz…” przy pliku z kopii). Bez uprawnien, tylko nazwa w PATH.
        -->
        <uap3:Extension Category="windows.appExecutionAlias"
          Executable="SigelithDesktop.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="sigelith-desktop.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      `runFullTrust` to JEDYNE uprawnienie, ktorego paczka zada — i jedyne,
      ktore program Win32 w MSIX musi miec. Nie deklarujemy ani dostepu do
      bibliotek dokumentow, ani `broadFileSystemAccess`: aplikacja czyta
      wylacznie pliki wskazane przez uzytkownika (przeciagniete albo wybrane
      w oknie dialogowym), a takie otwarcie nie wymaga osobnej zgody.
      Kazde dodatkowe uprawnienie to dodatkowe pytanie przy recenzji w Sklepie
      i dodatkowy tekst w karcie aplikacji — przy uprawnieniach z grupy
      „restricted" (`broadFileSystemAccess`) recenzja wymaga uzasadnienia.

      Katalog danych (`%USERPROFILE%\Sigelith`) tez ZADNEGO uprawnienia nie
      wymaga: aplikacja pelnozaufana z paczki pisze w profilu uzytkownika
      zwyklym Win32 (`open`/`CreateFile`) tak samo jak zwykly `.exe`.
      Uprawnienia `documentsLibrary` i `broadFileSystemAccess` bramkuja API
      `Windows.Storage` w aplikacjach AppContainer — nie te sciezke. Katalog
      lezy przy tym POZA `AppData`, wiec nie podlega wirtualizacji i przezywa
      odinstalowanie paczki: historia stempli zostaje na dysku uzytkownika.
    -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
